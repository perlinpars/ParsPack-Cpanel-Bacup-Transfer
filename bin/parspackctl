#!/bin/bash
set -euo pipefail
IFS=$' \t\n'
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT/lib/parspack-common.sh"

usage() {
  echo "Usage: $0 {doctor|connection-test|show-config|version|report|send-remaining|retry|verify|status|retention}" >&2
}

case "${1:-}" in
  version)
    cat "$ROOT/VERSION"
    ;;
  doctor|show-config)
    pp_find_python
    exec "$PYTHON3" "$ROOT/lib/parspack_config.py" "$1"
    ;;
  report)
    pp_find_python
    shift
    exec "$PYTHON3" "$ROOT/bin/report.py" "$@"
    ;;
  send-remaining)
    exec "$ROOT/bin/send-remaining.sh"
    ;;
  connection-test|retry|verify|status)
    pp_find_python
    exec "$PYTHON3" "$ROOT/lib/parspack_ops.py" "$@"
    ;;
  retention)
    pp_find_python
    shift
    exec "$PYTHON3" "$ROOT/lib/parspack_retention.py" "$@"
    ;;
  *)
    usage
    exit 1
    ;;
esac
